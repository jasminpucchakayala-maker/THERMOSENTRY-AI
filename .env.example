# THERMOSENTRY AI — Environment Configuration

# NASA FIRMS API Configuration
# Get a free API MAP_KEY from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# Base URL for NASA FIRMS API
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/

# Default query settings
FIRMS_DEFAULT_SOURCE=VIIRS_SNPP_NRT
FIRMS_DEFAULT_DAYS=1
FIRMS_DEFAULT_COUNTRY=IND
FIRMS_TIMEOUT_SECONDS=15

# Persistence analysis
PERSISTENCE_DISTANCE_THRESHOLD_KM=1.0
PERSISTENCE_TIME_WINDOW_DAYS=10

# OpenStreetMap Overpass
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_SEARCH_RADIUS_KM=5.0
OSM_TIMEOUT_SECONDS=6

# Explainable risk weights
RISK_WEIGHT_THERMAL_INTENSITY=0.45
RISK_WEIGHT_PERSISTENCE=0.20
RISK_WEIGHT_INDUSTRIAL_PROXIMITY=0.20
RISK_WEIGHT_CONFIDENCE=0.15

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
